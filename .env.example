# Copy to .env and fill in personal keys. Never commit .env.

# OpenAI Realtime (gpt-realtime-2.1) and optional TTS for stimuli
OPENAI_API_KEY=

# Gemini Live via a Google AI Studio key (NOT gcloud / Vertex)
GEMINI_API_KEY=

# xAI Grok Voice Agent API
XAI_API_KEY=

# Deepgram Voice Agent API
DEEPGRAM_API_KEY=

# Amazon Nova 2 Sonic (Bedrock bidirectional streaming)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
